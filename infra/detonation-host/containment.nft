#!/usr/sbin/nft -f
#
# Guest containment, in a table iptables cannot see, rewrite or reorder.
#
# WHY A SEPARATE TABLE
# --------------------
# Containment used to be hand-written iptables rules re-applied by a 60-second
# systemd timer. Three things were wrong with that, all measured on this host:
#
#   1. The timer's stated reason was false. CAPE's rooter does NOT flush our
#      rules - `cleanup_rooter` (utils/rooter.py:164) keeps every line that does
#      not contain the literal "CAPE-rooter", and ours carry no comment. What
#      rooter actually does is worse and quieter: it re-INSERTS
#      CAPE_ACCEPTED_SEGMENTS at FORWARD position 1, above our DROPs
#      (rooter.py:173-174), and its per-task egress hole is another `-I FORWARD`
#      at position 1 (rooter.py:1086). Position, not presence, was the exposure.
#
#   2. The window was 65.3 seconds. OnUnitActiveSec=60s plus AccuracySec=5s,
#      measured start-to-start at exactly 65.000s. Containment could be absent
#      the instant one run finished until the next one did.
#
#   3. The re-assertion script opened the hole itself. It deleted each DROP
#      before re-inserting it, leaving the INPUT drop absent for 145-233ms on
#      every tick - during which a guest reached the host's ufw chains,
#      including SSH. The mitigation was also a recurring vulnerability.
#
# An `inet` table is invisible to `iptables-save | iptables-restore`, which is
# what rooter runs over the whole ruleset, and its hooks run before the iptables
# chains regardless of what anyone inserts at position 1. Nothing to re-assert,
# so no window and no timer.
#
# VERIFIED ON THIS HOST, not assumed:
#   * an `inet` table survives an iptables-save|iptables-restore round trip
#   * a `drop` here overrides an `accept` in the iptables chains: a loopback
#     listener answering HTTP 200 went to 000 with a rule like these in place and
#     back to 200 when it was removed, while `-A ufw-before-input -i lo -j ACCEPT`
#     stayed in the iptables ruleset throughout.
# `policy accept` below does NOT accept anything globally. For a base chain it
# means "this chain reached no verdict" and the packet continues to the iptables
# chains as before. Only `drop` is final. That is the whole design.
#
# WHAT THIS DOES NOT COVER
# ------------------------
# Guest-to-guest traffic. All three guests share virbr0, and bridged traffic
# between ports of one bridge does not traverse the ip/inet forward hook at all:
# `net.bridge.bridge-nf-call-iptables = 0` on this host. A rule here would look
# like containment and never fire. Closing it needs a `table bridge` with a
# forward hook, which is a real option but has NOT been tested against a running
# guest - and an untested containment rule that silently breaks guest<->host is
# how this sandbox goes dark. Test it with a guest up before enabling it.

# Idempotent reload. `destroy table` would say this in one line but needs
# nftables >= 1.0.4; this host runs 1.0.2. The empty declaration creates the
# table if it is missing and does nothing if it is not, so the delete that
# follows always has something to remove. All three statements apply in one
# transaction, so there is no instant where the table is absent.
table inet cyclo_containment {}
delete table inet cyclo_containment

table inet cyclo_containment {
    # The host services a detonating sample is allowed to reach, and only at
    # 192.168.122.1 - never a wildcard, because CAPE's own web UI listens on
    # 0.0.0.0:8000 and rpcbind on 0.0.0.0:111.
    set host_tcp_ok {
        type inet_service
        elements = {
            2042,                                   # CAPE result server
            21, 25, 53, 80, 110, 443, 465, 990, 995, 6667,   # INetSim sinkhole
        }
    }
    set host_udp_ok {
        type inet_service
        elements = { 53, 69, 123 }                  # sinkhole DNS, TFTP, NTP
    }

    chain forward {
        type filter hook forward priority -300
        policy accept

        # The guest is routed NOWHERE - not merely "not to the WAN". The old
        # rules named an interface PAIR (`-i virbr0 -o enp41s0`), which left
        # every other egress interface open. On this host that was not
        # theoretical: virbr0 -> docker0 matched neither rule, fell through to
        # the DOCKER chain, and hit
        #   -A DOCKER -d 172.17.0.2/32 ! -i docker0 -o docker0 -p tcp --dport 8000 -j ACCEPT
        # so a detonating sample could reach the Cyclowareness API container
        # itself. Not a race - a permanent hole no amount of re-asserting the
        # timer would have closed, because the rule was never written.
        iifname "virbr0" oifname != "virbr0" drop
        oifname "virbr0" iifname != "virbr0" drop
    }

    chain input {
        type filter hook input priority -300
        policy accept

        # Only the guest bridge is our business. Everything else - SSH on the
        # WAN above all - is left entirely to the existing ruleset. This is what
        # makes the file safe to load on a box whose only door is port 22.
        iifname != "virbr0" accept

        # CAPE drives the guest agent over connections the HOST opens. Without
        # this the replies are dropped on the way back and the whole sandbox goes
        # dark - it has happened, and it looks like a broken analyzer.
        ct state established,related accept

        ip daddr 192.168.122.1 tcp dport @host_tcp_ok accept
        ip daddr 192.168.122.1 udp dport @host_udp_ok accept

        # DHCP, which a guest sends to 255.255.255.255 before it has an address,
        # so it cannot be matched on `ip daddr 192.168.122.1`.
        udp dport 67 accept

        # Counted, so `nft list table inet cyclo_containment` distinguishes "the
        # rule is present" from "the rule is working". A drop counter that never
        # moves while samples detonate means something is wrong upstream of here.
        counter drop
    }
}
