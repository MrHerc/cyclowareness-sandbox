# Cyclowareness Sandbox — configuration.
# Copy to .env and edit. Every value has a safe demo default; production is
# refused to boot until the placeholders below are replaced.

# demo (zero-setup, SQLite, seeded creds) | production (refuses unsafe config)
APP_ENV=demo

# SQLite for demo; PostgreSQL for production:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/sandbox
DATABASE_URL=sqlite:///./sandbox.db

# --- auth (CHANGE ALL THREE FOR PRODUCTION) ---
SECRET_KEY=dev-only-insecure-key-change-me
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=analyst
# Comma-separated static keys for programmatic /api/analyze access:
API_KEYS=demo-key
TOKEN_TTL_HOURS=12

# --- ingest ---
MAX_SAMPLE_MB=32

# --- AI (reserved, currently inert) ---
# RESERVED. Nothing reads this today: there is no LLM call anywhere in the
# codebase, `ai_provider` returns "template" unconditionally, and the triage
# narrative is written by a deterministic template.
#
# It used to be reported as "AI provider: anthropic" on /api/capabilities when
# set, and the UI reads that value to label the narrative as model-written — so
# the one screen that says what leaves the building named a third party this
# deployment never contacts. Setting this now changes nothing at all.
ANTHROPIC_API_KEY=

# --- dynamic tier (optional) ---
# Shared secret an off-host native-engine worker presents to claim jobs, fetch
# quarantined bytes, and post behavioural reports. Empty = dynamic ingest closed.
DYNAMIC_WORKER_TOKEN=

# --- quarantine location (optional) ---
# Where untrusted samples are stored, never executed. Mount this path noexec.
# SANDBOX_QUARANTINE=/var/lib/cyclowareness-sandbox/quarantine

# --- dev CORS (ignored in the single-origin Docker image) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
