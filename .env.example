# Cyclowareness Sandbox — configuration.
# Copy to .env and edit. Every value has a safe demo default; production is
# refused to boot until the placeholders below are replaced.

# demo (zero-setup, SQLite, seeded creds) | production (refuses unsafe config)
APP_ENV=demo

# SQLite for demo; PostgreSQL for production:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/sandbox
DATABASE_URL=sqlite:///./sandbox.db

# --- auth (CHANGE ALL THREE FOR PRODUCTION) ---
SECRET_KEY=dev-only-insecure-key-change-me
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=analyst
# Comma-separated static keys for programmatic /api/analyze access:
API_KEYS=demo-key
TOKEN_TTL_HOURS=12

# --- ingest ---
MAX_SAMPLE_MB=32

# --- AI (reserved, currently inert) ---
# RESERVED. Nothing reads this today: there is no LLM call anywhere in the
# codebase, `ai_provider` returns "template" unconditionally, and the triage
# narrative is written by a deterministic template.
#
# It used to be reported as "AI provider: anthropic" on /api/capabilities when
# set, and the UI reads that value to label the narrative as model-written — so
# the one screen that says what leaves the building named a third party this
# deployment never contacts. Setting this now changes nothing at all.
ANTHROPIC_API_KEY=

# --- dynamic tier (optional) ---
# Shared secret an off-host native-engine worker presents to claim jobs, fetch
# quarantined bytes, and post behavioural reports. Empty = dynamic ingest closed.
DYNAMIC_WORKER_TOKEN=

# --- quarantine location (optional) ---
# Where untrusted samples are stored, never executed. Mount this path noexec.
# SANDBOX_QUARANTINE=/var/lib/cyclowareness-sandbox/quarantine

# --- dev CORS (ignored in the single-origin Docker image) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- evidence signing (the one an operator most needs to know exists) ---
# Ed25519 private key, base64, 32 bytes. It signs two things: every exported
# report's attestation, and the audit chain's checkpoints — the signed anchors
# that make a re-chained audit table detectable.
#
# UNSET IS A REAL STATE, NOT A BROKEN ONE. Reports are stamped UNSIGNED and
# /api/audit/verify answers `anchored: false` with the reason. Nothing pretends
# otherwise, but nothing independent vouches for the chain either. A deployment
# whose evidence may be shown to a regulator or an opposing expert wants this
# set before it takes its first sample, because a key added later cannot sign
# what was already recorded.
#
# Generate one with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
SIGNING_KEY=

# --- retention (opt-in; 0 keeps forever) ---
# Days before the quarantined SAMPLE is deleted. Live malware sitting on the
# operator's disk is a hazard and a storage cost, needed after the analysis only
# for a re-run. The report row is unaffected.
SAMPLE_RETENTION_DAYS=0
# Days before the REPORT row goes. This is the evidence the customer bought, so
# it normally outlives the sample by a long way.
REPORT_RETENTION_DAYS=0
# How often the sweep runs.
RETENTION_SWEEP_HOURS=6

# --- sovereignty ---
# SOVEREIGN_MODE defaults ON and is the core promise: no analysis data leaves
# this deployment. The one deliberate exception is below — submitting a URL for
# analysis IS a request to fetch it, so the fetcher is not an exfiltration path.
# An air-gapped deployment closes it with 0/false.
SOVEREIGN_ALLOW_URL_FETCH=true

# --- notifying entity (NIS2 Article 23 / DORA Article 19 records) ---
# The engine cannot know who is running it. Left empty, the incident record says
# operator input is still required rather than inventing an entity.
ENTITY_NAME=
ENTITY_COUNTRY=
ENTITY_SECTOR=
ENTITY_CONTACT=

# --- tenancy ---
# Which tenant owns evidence submitted without an explicit one, and which tenant
# the seeded analyst account belongs to.
DEFAULT_TENANT=default
ANALYST_TENANT=default
